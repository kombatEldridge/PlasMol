echo
start n2_opt
title "N2 geometry optimization, PBE0/6-311G* Cartesian"
scratch_dir /Users/bldrdge1/Downloads/repos/PlasMol/jobs/final/Step_1/n2
permanent_dir /Users/bldrdge1/Downloads/repos/PlasMol/jobs/final/Step_1/n2
memory total 2500 mb
charge 0

geometry units angstroms noautosym noautoz
  N     -0.51680000     0.00000000     0.00000000
  N      0.51680000     0.00000000     0.00000000
