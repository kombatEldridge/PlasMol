 argument  1 = opt.nw



============================== echo of input deck ==============================
echo
start cs2_opt
title "CS2 geometry optimization, PBE0/6-311G* Cartesian"
scratch_dir /Users/bldrdge1/Downloads/repos/PlasMol/jobs/final/Step_1/cs2
permanent_dir /Users/bldrdge1/Downloads/repos/PlasMol/jobs/final/Step_1/cs2
memory total 2500 mb
charge 0

geometry units angstroms noautosym noautoz
  S     -1.55350000    -0.00000000    -0.00000000
  C      0.00000000     0.00000000     0.00000000
  S      1.55350000    -0.00000000    -0.00000000
end

basis cartesian
  * library 6-311G*
end

dft
  xc pbe0
  mult 1
  grid fine
  iterations 100
  convergence energy 1.0e-7
end

driver
  maxiter 120
end

task dft optimize
