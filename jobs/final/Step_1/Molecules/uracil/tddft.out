memory total 2500 mb
charge 0

geometry units angstroms noautosym noautoz
  O     -2.31155443    -0.99932227    -0.00080593
  C     -1.29287088    -0.34842682     0.00017123
  C     -1.19787501     1.10284516     0.00022238
  C      0.01004852     1.69315874     0.00040298
  N      1.17070392     0.97081625     0.00022883
  H      2.06892213     1.42429338    -0.00037341
  C      1.21213833    -0.41576895     0.00028357
  O      2.24518079    -1.03874716    -0.00064939
  N     -0.04122033    -0.98579304     0.00160553
  H     -0.05884801    -1.99532214     0.00222538
  H     -2.11411267     1.67550652     0.00009333
  H      0.13468074     2.77026722     0.00066790
end

basis cartesian
  * library 6-311G*
end

dft
  xc xwpbe 1.00 cpbe96 1.0 hfexch 1.00
  cam 0.318252 cam_alpha 0.00 cam_beta 1.00
  mult 1
  grid fine
  iterations 100
  convergence energy 1.0e-7
end

tddft
  nroots 30
  notriplet
end

