============================== echo of input deck ==============================
echo
start ch4_td
title "CH4 LR-TDDFT, LC-wPBE mu=0.453700, 6-311G* Cartesian, PBE0 geometry"
scratch_dir /Users/bldrdge1/Downloads/repos/PlasMol/jobs/final/Step_1/ch4
permanent_dir /Users/bldrdge1/Downloads/repos/PlasMol/jobs/final/Step_1/ch4
memory total 2500 mb
charge 0

geometry units angstroms noautosym noautoz
  C     -0.00000000    -0.00000000    -0.00000000
  H      0.00000000    -0.89042217    -0.62945650
  H      0.00000000     0.89042217    -0.62945650
  H     -0.89042217     0.00000000     0.62945650
  H      0.89042217     0.00000000     0.62945650
end

basis cartesian
  * library 6-311G*
end

dft
  xc xwpbe 1.00 cpbe96 1.0 hfexch 1.00
  cam 0.453700 cam_alpha 0.00 cam_beta 1.00
  mult 1
  grid fine
  iterations 100
  convergence energy 1.0e-7
end

tddft
  nroots 12
  notriplet
end

task tddft energy
