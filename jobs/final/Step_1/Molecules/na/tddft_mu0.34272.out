 argument  1 = tddft.nw



============================== echo of input deck ==============================
echo
start na_td
title "Na LR-TDDFT, LC-wPBE mu=0.342720, 6-311G* Cartesian, nucleus at the origin"
scratch_dir /Users/brinton/Downloads/repos/PlasMol/jobs/final/Step_1/Molecules/na
permanent_dir /Users/brinton/Downloads/repos/PlasMol/jobs/final/Step_1/Molecules/na
memory total 2500 mb
charge 0

geometry units angstroms noautosym noautoz
  Na     0.00000000     0.00000000     0.00000000
end

basis cartesian
  * library 6-311G*
end

dft
  xc xwpbe 1.00 cpbe96 1.0 hfexch 1.00
  cam 0.342720 cam_alpha 0.00 cam_beta 1.00
  mult 2
  grid fine
  iterations 100
  convergence energy 1.0e-7
end

tddft
  nroots 24
end

task tddft energy
