echo
start bf_opt
title "BF geometry optimization, PBE0/6-311G* Cartesian"
scratch_dir /Users/bldrdge1/Downloads/repos/PlasMol/jobs/final/Step_1/bf
permanent_dir /Users/bldrdge1/Downloads/repos/PlasMol/jobs/final/Step_1/bf
memory total 2500 mb
charge 0

geometry units angstroms noautosym noautoz
  B     -0.61410000     0.00000000     0.00000000
  F      0.34940000     0.00000000     0.00000000
end

basis cartesian
  * library 6-311G*
end

dft
  xc pbe0
  mult 1
  grid fine
  iterations 100
  convergence energy 1.0e-7
end

driver
  maxiter 120
end

task dft optimize
