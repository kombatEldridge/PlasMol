start c2h6_opt
title "C2H6 geometry optimization, PBE0/6-311G* Cartesian"
scratch_dir /Users/bldrdge1/Downloads/repos/PlasMol/jobs/final/Step_1/c2h6
permanent_dir /Users/bldrdge1/Downloads/repos/PlasMol/jobs/final/Step_1/c2h6
memory total 2500 mb
charge 0

geometry units angstroms noautosym noautoz
  C      0.76500000     0.00000000    -0.00000000
  C     -0.76500000    -0.00000000    -0.00000000
  H      1.12830000    -0.51380000     0.89000000
  H      1.12830000    -0.51380000    -0.89000000
  H      1.12830000     1.02770000     0.00000000
