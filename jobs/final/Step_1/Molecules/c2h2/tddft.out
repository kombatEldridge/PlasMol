============================== echo of input deck ==============================
echo
start c2h2_td
title "C2H2 LR-TDDFT, LC-wPBE mu=0.417415, 6-311G* Cartesian, PBE0 geometry"
scratch_dir /Users/bldrdge1/Downloads/repos/PlasMol/jobs/final/Step_1/c2h2
permanent_dir /Users/bldrdge1/Downloads/repos/PlasMol/jobs/final/Step_1/c2h2
memory total 2500 mb
charge 0

geometry units angstroms noautosym noautoz
  C     -0.59924845    -0.00000044     0.00000088
  C      0.59923761     0.00000045    -0.00000087
  H     -1.66550612     0.00000016    -0.00000032
  H      1.66551696    -0.00000017     0.00000031
end

basis cartesian
  * library 6-311G*
end

dft
  xc xwpbe 1.00 cpbe96 1.0 hfexch 1.00
  cam 0.417415 cam_alpha 0.00 cam_beta 1.00
  mult 1
  grid fine
  iterations 100
  convergence energy 1.0e-7
end

tddft
  nroots 16
  notriplet
end

task tddft energy
