echo
start beo_opt
title "BeO geometry optimization, PBE0/6-311G* Cartesian"
scratch_dir /Users/bldrdge1/Downloads/repos/PlasMol/jobs/final/Step_1/beo
permanent_dir /Users/bldrdge1/Downloads/repos/PlasMol/jobs/final/Step_1/beo
memory total 2500 mb
charge 0

geometry units angstroms noautosym noautoz
  O     -0.42640000     0.00000000     0.00000000
  Be     0.75720000     0.00000000     0.00000000
end

basis cartesian
  * library 6-311G*
end

dft
  xc pbe0
  mult 1
  grid fine
  iterations 100
  convergence energy 1.0e-7
end

driver
  maxiter 120
end

task dft optimize
