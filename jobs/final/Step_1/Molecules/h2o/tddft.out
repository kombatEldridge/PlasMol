 argument  1 = tddft.nw



============================== echo of input deck ==============================
echo
start h2o_td
title "H2O LR-TDDFT, LC-wPBE mu=0.546362, 6-311G* Cartesian, PBE0 geometry"
scratch_dir /Users/bldrdge1/Downloads/repos/PlasMol/jobs/final/Step_1/h2o
permanent_dir /Users/bldrdge1/Downloads/repos/PlasMol/jobs/final/Step_1/h2o
memory total 2500 mb
charge 0

geometry units angstroms noautosym noautoz
  O      0.00000000    -0.13864564    -0.00000000
  H     -0.76547805     0.43794282    -0.00000000
  H      0.76547805     0.43794282     0.00000000
end

basis cartesian
  * library 6-311G*
end

dft
  xc xwpbe 1.00 cpbe96 1.0 hfexch 1.00
  cam 0.546362 cam_alpha 0.00 cam_beta 1.00
  mult 1
  grid fine
  iterations 100
  convergence energy 1.0e-7
end

tddft
  nroots 12
  notriplet
end

task tddft energy
