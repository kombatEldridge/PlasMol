 argument  1 = opt.nw



============================== echo of input deck ==============================
echo
start h2o_opt
title "H2O geometry optimization, PBE0/6-311G* Cartesian"
scratch_dir /Users/bldrdge1/Downloads/repos/PlasMol/jobs/final/Step_1/h2o
permanent_dir /Users/bldrdge1/Downloads/repos/PlasMol/jobs/final/Step_1/h2o
memory total 2500 mb
charge 0

geometry units angstroms noautosym noautoz
  O     -0.00000000    -0.05890000    -0.00000000
  H     -0.81100000     0.46770000     0.00000000
  H      0.81100000     0.46770000     0.00000000
end

basis cartesian
  * library 6-311G*
end

dft
  xc pbe0
  mult 1
  grid fine
  iterations 100
  convergence energy 1.0e-7
end

driver
  maxiter 120
end

task dft optimize
