 argument  1 = tddft.nw



============================== echo of input deck ==============================
echo
start n2o_td
title "N2O LR-TDDFT, LC-wPBE mu=0.502324, 6-311G* Cartesian, PBE0 geometry"
scratch_dir /Users/bldrdge1/Downloads/repos/PlasMol/jobs/final/Step_1/n2o
permanent_dir /Users/bldrdge1/Downloads/repos/PlasMol/jobs/final/Step_1/n2o
memory total 2500 mb
charge 0

geometry units angstroms noautosym noautoz
  N     -1.19872103    -0.00000005    -0.00000010
  N     -0.07593522     0.00000014     0.00000025
  O      1.09949716    -0.00000009    -0.00000016
end

basis cartesian
  * library 6-311G*
end

dft
  xc xwpbe 1.00 cpbe96 1.0 hfexch 1.00
  cam 0.502324 cam_alpha 0.00 cam_beta 1.00
  mult 1
  grid fine
  iterations 100
  convergence energy 1.0e-7
end

tddft
  nroots 16
  notriplet
end

task tddft energy
