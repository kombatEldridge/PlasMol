 argument  1 = opt.nw



============================== echo of input deck ==============================
echo
start h2co_opt
title "H2CO geometry optimization, PBE0/6-311G* Cartesian"
scratch_dir /Users/bldrdge1/Downloads/repos/PlasMol/jobs/final/Step_1/h2co
permanent_dir /Users/bldrdge1/Downloads/repos/PlasMol/jobs/final/Step_1/h2co
memory total 2500 mb
charge 0

geometry units angstroms noautosym noautoz
  C      0.60720000     0.00000000    -0.00040000
  O     -0.60040000     0.00000000     0.00010000
  H      1.14720000     0.93530000     0.00160000
  H      1.14720000    -0.93530000     0.00160000
end

basis cartesian
  * library 6-311G*
end

dft
  xc pbe0
  mult 1
  grid fine
  iterations 100
  convergence energy 1.0e-7
end

driver
  maxiter 120
end

task dft optimize
