============================== echo of input deck ==============================
echo
start formamide_td
title "formamide LR-TDDFT, LC-wPBE mu=0.498438, 6-311G* Cartesian, PBE0 geometry"
scratch_dir /Users/bldrdge1/Downloads/repos/PlasMol/jobs/final/Step_1/formamide
permanent_dir /Users/bldrdge1/Downloads/repos/PlasMol/jobs/final/Step_1/formamide
memory total 2500 mb
charge 0

geometry units angstroms noautosym noautoz
  N      1.05072449     0.17194112    -0.00051620
  C     -0.18465811    -0.38350663    -0.00010156
  O     -1.22304104     0.22921811    -0.00043076
  H      1.13756459     1.17434388     0.00042674
  H      1.88303203    -0.38899045     0.00291057
  H     -0.14214696    -1.49118103     0.00008623
end

basis cartesian
  * library 6-311G*
end

dft
  xc xwpbe 1.00 cpbe96 1.0 hfexch 1.00
  cam 0.498438 cam_alpha 0.00 cam_beta 1.00
  mult 1
  grid fine
  iterations 100
  convergence energy 1.0e-7
end

tddft
  nroots 16
  notriplet
end

