============================== echo of input deck ==============================
echo
start nh3_opt
title "NH3 geometry optimization, PBE0/6-311G* Cartesian"
scratch_dir /Users/bldrdge1/Downloads/repos/PlasMol/jobs/final/Step_1/nh3
permanent_dir /Users/bldrdge1/Downloads/repos/PlasMol/jobs/final/Step_1/nh3
memory total 2500 mb
charge 0

geometry units angstroms noautosym noautoz
  N     -0.00000000    -0.00000000     0.05500000
  H     -0.01280000    -0.96010000    -0.25500000
  H      0.83790000     0.46900000    -0.25500000
  H     -0.82510000     0.49110000    -0.25500000
end

basis cartesian
  * library 6-311G*
end

dft
  xc pbe0
  mult 1
  grid fine
  iterations 100
  convergence energy 1.0e-7
end

driver
  maxiter 120
end

