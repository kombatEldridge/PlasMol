echo
start nh3_td
title "NH3 LR-TDDFT, LC-wPBE mu=0.470089, 6-311G* Cartesian, PBE0 geometry"
scratch_dir /Users/bldrdge1/Downloads/repos/PlasMol/jobs/final/Step_1/nh3
permanent_dir /Users/bldrdge1/Downloads/repos/PlasMol/jobs/final/Step_1/nh3
memory total 2500 mb
charge 0

geometry units angstroms noautosym noautoz
  N      0.00000483    -0.00002466     0.14648737
  H     -0.01249173    -0.93779252    -0.23500089
  H      0.81847285     0.45810416    -0.23474596
  H     -0.80598596     0.47971302    -0.23474052
end

basis cartesian
  * library 6-311G*
end

dft
  xc xwpbe 1.00 cpbe96 1.0 hfexch 1.00
  cam 0.470089 cam_alpha 0.00 cam_beta 1.00
  mult 1
  grid fine
  iterations 100
  convergence energy 1.0e-7
end

tddft
  nroots 12
  notriplet
end

task tddft energy
