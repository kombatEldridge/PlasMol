 argument  1 = opt.nw



============================== echo of input deck ==============================
echo
start h2s_opt
title "H2S geometry optimization, PBE0/6-311G* Cartesian"
scratch_dir /Users/bldrdge1/Downloads/repos/PlasMol/jobs/final/Step_1/h2s
permanent_dir /Users/bldrdge1/Downloads/repos/PlasMol/jobs/final/Step_1/h2s
memory total 2500 mb
charge 0

geometry units angstroms noautosym noautoz
  S     -0.00000000    -0.04950000    -0.00000000
  H     -1.05260000     0.78770000     0.00000000
  H      1.05260000     0.78770000     0.00000000
end

basis cartesian
  * library 6-311G*
end

dft
  xc pbe0
  mult 1
  grid fine
  iterations 100
  convergence energy 1.0e-7
end

driver
  maxiter 120
end

task dft optimize
