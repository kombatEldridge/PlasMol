 argument  1 = tddft.nw



============================== echo of input deck ==============================
echo
start so2_td
title "SO2 LR-TDDFT, LC-wPBE mu=0.499839, 6-311G* Cartesian, PBE0 geometry"
scratch_dir /Users/bldrdge1/Downloads/repos/PlasMol/jobs/final/Step_1/so2
permanent_dir /Users/bldrdge1/Downloads/repos/PlasMol/jobs/final/Step_1/so2
memory total 2500 mb
charge 0

geometry units angstroms noautosym noautoz
  O     -1.24667393     0.40704700     0.00000000
  S     -0.00001284    -0.32880004    -0.00000000
  O      1.24668677     0.40705304     0.00000000
end

basis cartesian
  * library 6-311G*
end

dft
  xc xwpbe 1.00 cpbe96 1.0 hfexch 1.00
  cam 0.499839 cam_alpha 0.00 cam_beta 1.00
  mult 1
  grid fine
  iterations 100
  convergence energy 1.0e-7
end

tddft
  nroots 16
  notriplet
end

task tddft energy
