 argument  1 = opt.nw



============================== echo of input deck ==============================
echo
start o2_opt
title "O2 geometry optimization, PBE0/6-311G* Cartesian"
scratch_dir /Users/bldrdge1/Downloads/repos/PlasMol/jobs/final/Step_1/o2
permanent_dir /Users/bldrdge1/Downloads/repos/PlasMol/jobs/final/Step_1/o2
memory total 2500 mb
charge 0

geometry units angstroms noautosym noautoz
  O     -0.50180000     0.00000000     0.00000000
  O      0.50180000     0.00000000     0.00000000
end

basis cartesian
  * library 6-311G*
end

dft
  xc pbe0
  mult 3
  grid fine
  iterations 100
  convergence energy 1.0e-7
end

driver
  maxiter 120
end

task dft optimize
