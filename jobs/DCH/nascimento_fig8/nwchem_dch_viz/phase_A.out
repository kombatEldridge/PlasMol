  2.0
  2.0
end

dft
  xc pbe0
  mult 1
  noscf
  vectors input neutral.movecs output dch.movecs
end

task dft energy

set geometry "mol"
unset rt_tddft:*

rt_tddft
  tmax 40.0
  dt 0.05
  propagator magnus
  nprints *
  nrestarts 5
  nchecks 2
  print dipole charge energy
  load vectors dch.movecs
  tag "<rt_tddft>"
  visualization
    tstart 0.0
    tend 40.0
  end
end

task dft rt_tddft
