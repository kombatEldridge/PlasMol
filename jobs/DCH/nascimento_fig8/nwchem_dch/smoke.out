  mult 1
  noscf
  vectors input smoke_neutral.movecs output smoke_dch.movecs
end

task dft energy

set geometry "mol"
unset rt_tddft:*

rt_tddft
  tmax 1.0
  dt 0.05
  propagator magnus
  nprints *
  nrestarts 0
  nchecks 2
  print dipole moocc charge energy
  load vectors smoke_dch.movecs
  tag "<rt_tddft>"
end

task dft rt_tddft
